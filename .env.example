NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:4200

# Use mysql for production MySQL 8.4. Use mariadb for this machine's XAMPP 10.4.
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wokim
DB_USER=wokim
DB_PASSWORD=replace-me
DB_SSL=false

# Generate separate values with at least 32 random bytes for production.
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-32-character-secret
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
PRIVATE_STORAGE_ROOT=./storage/private
LOG_LEVEL=info
