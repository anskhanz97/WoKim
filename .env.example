NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:4200

# Use mariadb for this machine's XAMPP 10.4. The mysql option remains for compatibility checks.
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=wokim
DB_USER=wokim
DB_PASSWORD=replace-me
DB_SSL=false

# Generate separate local values with at least 32 random bytes.
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-32-character-secret
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# On Windows, use an absolute path on a data drive so process working directories cannot relocate originals.
PRIVATE_STORAGE_ROOT=D:/path/to/wokim/storage/private
MODEL_CACHE_ROOT=D:/path/to/wokim/storage/models
TEMP=D:/path/to/wokim/storage/tmp
TMP=D:/path/to/wokim/storage/tmp
# Refuse new file uploads before storage exhaustion; reads and exports remain available.
STORAGE_UPLOAD_STOP_PERCENT=95
STORAGE_MINIMUM_FREE_BYTES=1073741824
EXPORT_RETENTION_HOURS=24
TRASH_RETENTION_DAYS=30
LOG_LEVEL=info
