{
  "name": "@wokim/api",
  "version": "0.0.1",
  "description": "WoKim private API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "tsx src/worker.ts",
    "worker:once": "tsx src/worker.ts --once",
    "db:migrate": "tsx src/database/run-migrations.ts",
    "db:revert": "tsx src/database/revert-migration.ts",
    "owner:bootstrap": "tsx src/cli/owner-bootstrap.ts",
    "owner:reset": "tsx src/cli/owner-reset.ts",
    "db:seed:showcase": "node scripts/seed-showcase.cjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "tsx test/e2e-smoke.ts",
    "test:e2e:focus": "tsx test/focus-e2e.ts",
    "test:e2e:phase5": "tsx test/phase-five-e2e.ts",
    "test:e2e:phase6": "tsx test/phase-six-e2e.ts",
    "test:e2e:phase7": "tsx test/phase-seven-e2e.ts",
    "test:transcription": "tsx test/transcription-smoke.ts",
    "test:performance": "tsx test/performance-smoke.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "^12.0.2",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.1.0",
    "music-metadata": "^12.2.3",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
