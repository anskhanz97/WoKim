{
  "info": {
    "name": "WoKim Phase 1 smoke",
    "description": "Local smoke flow for CSRF, owner login, authenticated profile, readiness, and logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000/api/v1" },
    { "key": "ownerEmail", "value": "owner@example.test" },
    { "key": "ownerPassword", "value": "replace-before-running", "type": "secret" },
    { "key": "csrfToken", "value": "" }
  ],
  "item": [
    {
      "name": "Issue CSRF token",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('CSRF token issued', () => pm.expect(pm.response.code).to.equal(200));",
            "pm.collectionVariables.set('csrfToken', pm.response.json().data.token);"
          ]
        }
      }],
      "request": { "method": "GET", "url": "{{baseUrl}}/auth/csrf" }
    },
    {
      "name": "Owner login",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('Owner authenticated', () => pm.expect(pm.response.code).to.equal(200));"] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Origin", "value": "http://localhost:4200" },
          { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\",\n  \"deviceLabel\": \"Postman phase 1 smoke\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Read owner profile",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Private profile is available', () => pm.expect(pm.response.code).to.equal(200));",
            "pm.test('No password hash is exposed', () => pm.expect(pm.response.text()).not.to.include('passwordHash'));"
          ]
        }
      }],
      "request": { "method": "GET", "url": "{{baseUrl}}/me" }
    },
    {
      "name": "Read authenticated readiness",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('Database and storage are ready', () => pm.expect(pm.response.code).to.equal(200));"] }
      }],
      "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" }
    },
    {
      "name": "Logout",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('Session revoked', () => pm.expect(pm.response.code).to.equal(204));"] }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Origin", "value": "http://localhost:4200" },
          { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
        ],
        "url": "{{baseUrl}}/auth/logout"
      }
    }
  ]
}
